# LLM API key (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=sk-xxx

# GitHub API token (for GitHub repo/trending extractors)
GITHUB_TOKEN=ghp_xxx

# Exa API key (for active source discovery)
EXA_API_KEY=exa-xxx

# Embedding model cache/download
FASTEMBED_CACHE_PATH=~/.cache/fastembed
HF_ENDPOINT=https://huggingface.co
HF_HUB_DISABLE_XET=1

# LangSmith tracing (optional)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=xxx
# LANGSMITH_PROJECT=weekly-ai-report
